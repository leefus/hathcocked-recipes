# Copy to .env.local and fill in. NEVER commit the real file.
# Get a fresh token at https://notion.so/my-integrations
NOTION_TOKEN=ntn_replace_me

# Your Family Recipes data source (not the database id from the URL)
NOTION_DATA_SOURCE_ID=9c76e974-945b-450f-805d-0dcbf07e670a

# Any random string; used to force a refresh after editing Notion
REVALIDATE_SECRET=pick_something_random
